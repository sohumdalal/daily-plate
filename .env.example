# Daily Plate — local dev.
#
# You probably don't need this file. `bun run dev` (scripts/dev.ts) already
# loads secrets from ~/.ast/project-configs.json and takes a live GitHub token
# from `gh auth token`. Copy this only if you'd rather be explicit.
#
# In production none of it is needed: Astropods prompts for each value declared
# in astropods.yml (`agent.inputs`) and injects the rest from the
# `integrations` and `knowledge` blocks.

# Reads the boards. Needs `read:project` + `repo`.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=sohumdalal
# owner/number, comma-separated. Astro Kanban and Astro Kanban (AI).
GITHUB_PROJECTS=astropods/1,astropods/4

# Your Slack member id. Turns on mention capture.
# SLACK_USER_ID=U0XXXXXXXXX

# What "cleared today" means.
TIMEZONE=America/New_York

# Postgres. Injected by the `knowledge.daily-plate-db` entry in production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daily_plate
POSTGRES_USER=
POSTGRES_PASSWORD=

# Server. 3003 locally; the deployed container must bind 80.
PORT=3003
